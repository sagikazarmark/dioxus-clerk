type Assets {
  let node: NodeEnvironment!

  new {
    self.node = Dagger.nodeEnvironment(install: true, locked: true)

    self
  }

  """
  Generated assets.
  """
  directory(ws: Workspace!): Directory! {
    Dagger
      .directory
      .withFile("build/style.css", self.style(ws))
  }

  """
  Generated assets.
  """
  asContainer(ws: Workspace!): Container! {
    Dagger
      .container
      .withDirectory("", self.directory(ws))
  }

  """
  Style generated by tailwindcss.
  """
  style(ws: Workspace!): File! {
    self
      .node
      .container(ws)
      .withExec(["npm", "exec", "--", "tailwindcss", "-i", "src/style.css", "-o", "style.css", "--minify"])
      .file("style.css")
  }

  let withAssets(ws: Workspace!): Workspace! {
    # DAGGER_TODO:
    # generated assets are normally ignored by git, so adding them back causes
    # them to be ignored next time workspace is called
    ws
      .withNewFile(
        ".gitignore",
        ws.file(".gitignore").contents + "\n" + ["!/build/style.css"].join("\n"),
      )
      .withNewDirectory("build", self.directory(ws).directory("build"))
  }
}
