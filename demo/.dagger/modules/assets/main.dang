type Assets {
  let node: NodeEnvironment!

  new(ws: Workspace!) {
    self.node = Dagger.nodeEnvironment(ws: ws, install: true, locked: true)

    self
  }

  """
  Generated assets.
  """
  directory: Directory! {
    Dagger
      .directory
      .withFile("build/style.css", self.style)
  }

  """
  Generated assets.
  """
  asContainer: Container! {
    Dagger
      .container
      .withDirectory("", self.directory)
  }

  """
  Style generated by tailwindcss.
  """
  style: File! {
    self
      .node
      .container
      .withExec(["npm", "exec", "--", "tailwindcss", "-i", "src/style.css", "-o", "style.css", "--minify"])
      .file("style.css")
  }
}
