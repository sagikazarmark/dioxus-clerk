type App {
  workerBundle: Directory!
  workerBundleAsContainer: Container!

  new(
    client: Container!,
    worker: Container!,
  ) {
    self.workerBundle = Dagger
      .directory
      .withDirectory("dist", client.directory(""))
      .withDirectory("dist/worker", worker.directory(""))
    self.workerBundleAsContainer = Dagger.container.withDirectory("", self.workerBundle)

    self
  }
}
